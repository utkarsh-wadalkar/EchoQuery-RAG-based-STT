# =============================================================
# EchoQuery — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# =============================================================

# ---- Application ------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# ---- CORS -------------------------------------------------------
# Comma-separated list (or use JSON array syntax)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- STT Provider ------------------------------------------------
# Force a specific provider: sarvam | voxtral | mock
# If omitted, auto-selects based on available API keys.
# STT_PROVIDER=mock

# Sarvam Saaras v3 (production)
SARVAM_API_KEY=
# SARVAM_ENDPOINT=https://api.sarvam.ai/speech-to-text
# SARVAM_MODEL=saaras:v3

# Voxtral Mini (testing)
VOXTRAL_API_KEY=
# VOXTRAL_ENDPOINT=https://api.mistral.ai/v1/audio/transcriptions
# VOXTRAL_MODEL=mistral-voxtral-mini

# ---- RAG Engine --------------------------------------------------
# URL of the RAG engine API.  Empty = use mock.
RAG_ENDPOINT=
RAG_TIMEOUT_SECONDS=30

# ---- Audio -------------------------------------------------------
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=30

# ---- Server ------------------------------------------------------
HOST=0.0.0.0
PORT=8000
